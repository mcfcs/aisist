{
  "manifest_version": 3,
  "name": "AISIS Course Companion",
  "version": "1.7.0",
  "description": "Open course syllabi, read course-prioritized professor reviews, and draft next term's schedule beside AISIS class schedules.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://profstopick.com/*",
    "https://aisis.ateneo.edu/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://aisis.ateneo.edu/j_aisis/welcome.do*"
      ],
      "js": [
        "lib/settings.js",
        "home.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://aisis.ateneo.edu/j_aisis/J_VCSC.do*",
        "https://aisis.ateneo.edu/j_aisis/classSkeds.do*"
      ],
      "js": [
        "lib/core.js",
        "lib/syllabus.js",
        "lib/settings.js",
        "lib/plan.js",
        "lib/plan-ui.js",
        "lib/aisis.js",
        "lib/offerings.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "AISIS Course Companion",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/eagle-16.png",
      "32": "icons/eagle-32.png"
    }
  },
  "icons": {
    "16": "icons/eagle-16.png",
    "32": "icons/eagle-32.png",
    "48": "icons/eagle-48.png",
    "128": "icons/eagle-128.png"
  }
}
